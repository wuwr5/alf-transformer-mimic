# Normalise line endings so the CI matrix (Linux + Windows) behaves identically.
* text=auto eol=lf

# Explicit for files whose tooling is picky
*.py    text eol=lf
*.R     text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.cff   text eol=lf
*.json  text eol=lf

# Windows-only helpers keep CRLF
*.ps1   text eol=crlf
*.bat   text eol=crlf

# Binary
*.png   binary
*.jpg   binary
*.pdf   binary
*.npy   binary
*.pt    binary
